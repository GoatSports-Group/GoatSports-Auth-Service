<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="2026-09-23-add-player-profile-city" author="goat-sports">
        <comment>
            Province/city a sport profile is shown in for scouting. Nullable so existing profiles stay valid;
            the API requires it on every create/update from now on.
        </comment>
        <addColumn tableName="player_sport_profiles">
            <column name="city" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
