<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="20260828-auth-align-user-role" author="codex">
        <addColumn tableName="users">
            <column name="date_of_birth" type="DATE"/>
        </addColumn>
        <addUniqueConstraint tableName="roles" columnNames="name" constraintName="uk_roles_name"/>
        <addForeignKeyConstraint
                baseTableName="users" baseColumnNames="role_id"
                referencedTableName="roles" referencedColumnNames="role_id"
                constraintName="fk_users_role"/>
        <addNotNullConstraint tableName="roles" columnName="name" columnDataType="VARCHAR(255)"/>
        <addNotNullConstraint tableName="users" columnName="role_id" columnDataType="UUID"/>
    </changeSet>

    <changeSet id="20260828-auth-create-player-sport-profile" author="codex">
        <createTable tableName="player_sport_profiles">
            <column name="profile_id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_player_sport_profiles"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="DATETIME"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="sport_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="skill_level" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="elo_rating" type="INTEGER"/>
            <column name="play_style" type="VARCHAR(255)"/>
            <column name="latitude" type="DOUBLE"/>
            <column name="longitude" type="DOUBLE"/>
            <column name="play_radius_km" type="DOUBLE"/>
            <column name="win_count" type="INTEGER"/>
            <column name="loss_count" type="INTEGER"/>
            <column name="draw_count" type="INTEGER"/>
            <column name="match_count" type="INTEGER"/>
            <column name="win_rate" type="DOUBLE"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="player_sport_profiles" baseColumnNames="user_id"
                referencedTableName="users" referencedColumnNames="user_id"
                constraintName="fk_player_sport_profiles_user" onDelete="CASCADE"/>
        <addUniqueConstraint
                tableName="player_sport_profiles" columnNames="user_id,sport_type"
                constraintName="uk_player_sport_profile_user_sport"/>
        <createIndex tableName="player_sport_profiles" indexName="idx_player_sport_profile_user">
            <column name="user_id"/>
        </createIndex>

        <createTable tableName="player_preferred_positions">
            <column name="profile_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="player_preferred_positions" columnNames="profile_id,position"
                       constraintName="pk_player_preferred_positions"/>
        <addForeignKeyConstraint
                baseTableName="player_preferred_positions" baseColumnNames="profile_id"
                referencedTableName="player_sport_profiles" referencedColumnNames="profile_id"
                constraintName="fk_player_preferred_positions_profile" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="20260828-auth-create-availability" author="codex">
        <createTable tableName="availabilities">
            <column name="availability_id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_availabilities"/>
            </column>
            <column name="profile_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="day_of_week" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="start_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="timezone" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="availabilities" baseColumnNames="profile_id"
                referencedTableName="player_sport_profiles" referencedColumnNames="profile_id"
                constraintName="fk_availabilities_profile" onDelete="CASCADE"/>
        <createIndex tableName="availabilities" indexName="idx_availabilities_profile">
            <column name="profile_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
