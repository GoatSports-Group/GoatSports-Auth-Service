<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1783416101641-1" author="minhdat">
        <createTable tableName="permissions">
            <column name="permission_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_permissions"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="DATETIME"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="api_path" type="VARCHAR(255)"/>
            <column name="method" type="VARCHAR(255)"/>
            <column name="module" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1783416101641-2" author="minhdat">
        <createTable tableName="role_permission">
            <column name="permission_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_role_permission"/>
            </column>
            <column name="role_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_role_permission"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1783416101641-3" author="minhdat">
        <createTable tableName="roles">
            <column name="role_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_roles"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="DATETIME"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(255)"/>
            <column name="active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1783416101641-4" author="minhdat">
        <createTable tableName="user_auth_providers">
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="auth_provider" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1783416101641-5" author="minhdat">
        <createTable tableName="users">
            <column name="user_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_users"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="DATETIME"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="keycloak_id" type="UUID"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="username" type="VARCHAR(255)"/>
            <column name="password" type="VARCHAR(255)"/>
            <column name="full_name" type="VARCHAR(255)"/>
            <column name="avatar_url" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(255)"/>
            <column name="gender" type="VARCHAR(255)"/>
            <column name="role_id" type="UUID"/>
        </createTable>
    </changeSet>
    <changeSet id="1783416101641-9" author="minhdat">
        <addForeignKeyConstraint baseColumnNames="permission_id" baseTableName="role_permission"
                                 constraintName="fk_rolper_on_permission_entity" referencedColumnNames="permission_id"
                                 referencedTableName="permissions"/>
    </changeSet>
    <changeSet id="1783416101641-10" author="minhdat">
        <addForeignKeyConstraint baseColumnNames="role_id" baseTableName="role_permission"
                                 constraintName="fk_rolper_on_role_entity" referencedColumnNames="role_id"
                                 referencedTableName="roles"/>
    </changeSet>
    <changeSet id="1783416101641-11" author="minhdat">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="user_auth_providers"
                                 constraintName="fk_user_auth_providers_on_user_entity" referencedColumnNames="user_id"
                                 referencedTableName="users"/>
    </changeSet>

</databaseChangeLog>